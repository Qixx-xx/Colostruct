# ============================================================
# ColoStruct environment template
#
# Copy this file to ".env" (git-ignored) and change only the values
# that differ on this machine. Never commit a real ".env", model
# weights, audio, or personal absolute paths.
#
# Every variable listed below is read by the current code. Optional
# values that usually keep their defaults are commented out.
# ============================================================

# --- LLM / Ollama (read by core/llm/client.py) ---
COLOSTRUCT_OLLAMA_URL=http://127.0.0.1:11434
COLOSTRUCT_LLM_MODEL=qwen3:8b
COLOSTRUCT_LLM_TIMEOUT=180
COLOSTRUCT_LLM_TEMPERATURE=0
COLOSTRUCT_OLLAMA_KEEP_ALIVE=10m
COLOSTRUCT_OLLAMA_THINK=false

# --- ASR backend (read by core/pipeline.py) ---
# "hf" = the Transformers checkpoint verified by Group A
#        (requires torch/transformers from requirements.txt).
# anything else = faster-whisper using ASR_MODEL below.
COLOSTRUCT_ASR_BACKEND=hf
WHISPER_MODEL_ID=JackyHoCL/whisper-small-cantonese-yue-english
WHISPER_REVISION=bde975727e573bb92d4c4ee3c05a29a0f79fb195
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
# 1 = never contact Hugging Face (offline machine with a populated cache).
WHISPER_LOCAL_FILES_ONLY=0

# Optional: local checkpoint directory for offline machines. Leave commented
# to use the Hugging Face cache, or to download by WHISPER_MODEL_ID.
# WHISPER_MODEL_PATH=D:\Colostruct-Models\whisper

# faster-whisper fallback (used when COLOSTRUCT_ASR_BACKEND is not "hf")
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- Model caches (keep multi-GB weights outside the repository) ---
# Uncomment and point at a data drive to keep them off the system drive.
# HF_HOME=D:\Colostruct-Models\huggingface
# OLLAMA_MODELS=D:\Colostruct-Models\ollama

# --- Storage (stitched audio is written below this root) ---
STORAGE_DIR=./storage

# Optional: explicit ffmpeg binary. Leave commented to use imageio-ffmpeg
# (installed from requirements.txt) or ffmpeg on PATH.
# FFMPEG_BINARY=D:\tools\ffmpeg\bin\ffmpeg.exe

# --- Frontend -> backend API (read by ui/upload_panel.py) ---
# Point at the machine that runs api.py; use 127.0.0.1 for a local demo.
BACKEND_API_URL=http://127.0.0.1:8000/api/process

# --- Backend bind address (read by api.py) ---
# Keep 127.0.0.1 for single-machine use. 0.0.0.0 exposes clinical audio on
# the LAN without authentication, so only do that on a trusted network.
API_HOST=127.0.0.1
API_PORT=8000

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501

# --- Windows encoding (read by the Python interpreter at startup) ---
# python-dotenv loads .env *after* the interpreter has started, so setting
# this here does NOT switch the current process to UTF-8 mode. Export it in
# the shell before launching Python, or set it as a Windows user variable:
#   $env:PYTHONUTF8 = "1"
# PYTHONUTF8=1

# --- Optional: real-model ASR tests (skipped by default) ---
# ASR_RUN_REAL_MODEL=0
# ASR_RUN_REAL_TRANSCRIBE=0
# ASR_REAL_AUDIO=
# COLOSTRUCT_REPO_ROOT=
