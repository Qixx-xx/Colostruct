# Environment template. Export these values or pass them to Docker.
# Never commit a real .env or any secrets.

# --- A-group Ollama / LLM client (these are the variable names the client reads) ---
COLOSTRUCT_OLLAMA_URL=http://127.0.0.1:11434
COLOSTRUCT_LLM_MODEL=qwen3:8b
COLOSTRUCT_LLM_TIMEOUT=180
COLOSTRUCT_LLM_TEMPERATURE=0

# --- Project-facing LLM aliases (config skeleton for future wiring) ---
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=180
LLM_TEMPERATURE=0

# --- Storage ---
STORAGE_DIR=./storage
DATABASE_PATH=./storage/colostruct.db

# --- ASR ---
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501

# --- Frontend -> Backend API Connection ---
BACKEND_API_URL=http://127.0.0.1:8000/api/process